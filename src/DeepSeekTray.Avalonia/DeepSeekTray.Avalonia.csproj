<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DeepSeekTray</RootNamespace>
    <AssemblyName>DeepSeekTray</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Version>2.1.0</Version>
    <FileVersion>2.1.0.0</FileVersion>
    <Product>DeepSeek 余额托盘</Product>
    <AssemblyTitle>DeepSeek 余额托盘</AssemblyTitle>
    <Company>DeepSeekTray</Company>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Skia/HarfBuzz 自带的 pdb 加起来 100MB，发布时不要带上 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <!-- SkiaSharp / HarfBuzzSharp 包自带的原生 .pdb 加起来 100MB，发布时直接剔除 -->
  <Target Name="StripNativePdbs" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
