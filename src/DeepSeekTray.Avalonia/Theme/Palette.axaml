<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBg" Color="#F4F5F7" />
            <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAlt" Color="#F2F4F7" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#EDF0F5" />
            <SolidColorBrush x:Key="Line" Color="#E3E6EB" />
            <SolidColorBrush x:Key="LineStrong" Color="#D3D8E0" />

            <SolidColorBrush x:Key="TextMain" Color="#111827" />
            <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />
            <SolidColorBrush x:Key="TextFaint" Color="#9CA3AF" />

            <SolidColorBrush x:Key="Accent" Color="#2563EB" />
            <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
            <SolidColorBrush x:Key="AccentSoft" Color="#E8EFFE" />
            <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

            <SolidColorBrush x:Key="Danger" Color="#DC2626" />
            <SolidColorBrush x:Key="Success" Color="#16A34A" />
            <SolidColorBrush x:Key="Warning" Color="#D97706" />

            <SolidColorBrush x:Key="CardShadow" Color="#1F000000" />
            <SolidColorBrush x:Key="Overlay" Color="#E6F4F5F7" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBg" Color="#0F1115" />
            <SolidColorBrush x:Key="Surface" Color="#171A21" />
            <SolidColorBrush x:Key="SurfaceAlt" Color="#1E222B" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#252A35" />
            <SolidColorBrush x:Key="Line" Color="#2A2F3A" />
            <SolidColorBrush x:Key="LineStrong" Color="#3A4150" />

            <SolidColorBrush x:Key="TextMain" Color="#E8EBF1" />
            <SolidColorBrush x:Key="TextMuted" Color="#9AA3B2" />
            <SolidColorBrush x:Key="TextFaint" Color="#6B7382" />

            <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
            <SolidColorBrush x:Key="AccentHover" Color="#6BA0FF" />
            <SolidColorBrush x:Key="AccentSoft" Color="#1B2A44" />
            <SolidColorBrush x:Key="OnAccent" Color="#0B1220" />

            <SolidColorBrush x:Key="Danger" Color="#F87171" />
            <SolidColorBrush x:Key="Success" Color="#34D399" />
            <SolidColorBrush x:Key="Warning" Color="#FBBF24" />

            <SolidColorBrush x:Key="CardShadow" Color="#66000000" />
            <SolidColorBrush x:Key="Overlay" Color="#E61A1D24" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
