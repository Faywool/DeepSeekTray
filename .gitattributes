# 默认按文本处理，统一 LF，避免 Windows/Linux 协作时整文件 diff
* text=auto eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
*.pdb binary

# 这些文件必须保持 LF
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 这些文件必须保持 CRLF（Windows 脚本/配置文件）
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
